{
  "manifest_version": 3,
  "name": "YT Music Lyrics — Final",
  "version": "2.0.0",
  "description": "Apple Music-style synced lyrics for YouTube Music",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "*://music.youtube.com/*",
    "https://lrclib.net/*",
    "https://apic-desktop.musixmatch.com/*",
    "https://lyrics.api.dacubeking.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "css": ["lyrics.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["playerBridge.js"],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
